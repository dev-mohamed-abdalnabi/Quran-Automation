name: QuranBot
on:
  workflow_dispatch:
  schedule:
    - cron: '0 11 * * *'

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - set up python:
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'
      - install:
        run: |
          sudo apt-get update && sudo apt-get install -y ffmpeg
          pip install moviepy==1.0.3 arabic-reshaper python-bidi proglog google-api-python-client google-auth-oauthlib requests numpy pillow
      - execute:
        env:
          TOKEN_BASE64: ${{ secrets.TOKEN_BASE64 }}
          CLIENT_SECRET: ${{ secrets.CLIENT_SECRET }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
        run: python main.py
